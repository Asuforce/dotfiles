#!/bin/bash

# The Touch Bar's /dev/tiny_dfr_* aliases vanish across suspend and come back
# under new paths, so the udev SYSTEMD_WANTS trigger never fires. tiny-dfr is
# still active when this hook runs and only gets stopped once its devices drop
# out a moment later, so a single start at resume time is a no-op. Poll for a
# while and start it whenever it is found down; backgrounded so resume is not
# held up.

if [[ $1 == "post" ]]; then
  (
    for _ in {1..30}; do
      systemctl is-active --quiet tiny-dfr || systemctl start tiny-dfr
      sleep 1
    done
  ) >/dev/null 2>&1 &
fi
