#!/usr/bin/env bash
set -euo pipefail

user=@USER@

# systemd fires the timer once on resume for the tick missed in sleep; without
# this guard that run re-suspends at 05:55, before the 06:00 crawl.
hour=$((10#$(date +%H)))
(( hour >= 22 || hour <= 4 )) || exit 0

# From 22:30 the machine suspends even with the screen open; `stay-awake` still blocks it.
# Before that, and only then, a lock (omarchy locks after 5 idle minutes or on lid close)
# is the idle signal; exit 1 (unlocked) and 2 (undetermined) both mean someone may be there.
if (( hour == 22 && 10#$(date +%M) < 30 )); then
  runtime_dir="/run/user/$(id -u "$user")"
  runuser -u "$user" -- env \
    XDG_RUNTIME_DIR="$runtime_dir" \
    HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$runtime_dir/hypr" | head -1)" \
    omarchy-hyprland-session-locked || exit 0
fi

# After midnight 05:55 is still today, not tomorrow.
wake=$(date -d 05:55 +%s)
(( wake > $(date +%s) )) || wake=$(date -d 'tomorrow 05:55' +%s)

# systemctl suspend, not rtcwake -m mem: only the logind path takes the lock-screen
# inhibitor and honours `stay-awake`.
rtcwake -m no -t "$wake"
systemctl suspend

# supercronic's timer does not advance while suspended, so it must recompute 06:00.
docker restart mf-dashboard-crawler-1
