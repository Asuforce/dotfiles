{"nodes": [{"id": "claude_dotfiles_architecture", "label": "Dotfiles symlink architecture (config/ + scripts/link.sh)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_omarchy_linux_target", "label": "omarchy (Arch Linux) target via uname -s branching", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Key notes", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_idempotent_scripts", "label": "Idempotent scripts with set -euo pipefail", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Key notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-running must never overwrite existing configurations; scripts check existence before creating links/dirs."}, {"id": "claude_copied_configs", "label": "Copied (not symlinked) git/SSH/zshrc.work configs", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Key notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copied rather than symlinked to allow local modification."}, {"id": "claude_herdr_owns_multiplexing", "label": "herdr owns terminal multiplexing (prefix ctrl+g)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Key notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ghostty binds no leader or pane/tab keys so they never shadow herdr's prefix."}, {"id": "claude_ghostty_terminal", "label": "Ghostty terminal (kitty keyboard + graphics protocols)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Key notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "herdr vendors Ghostty's VT engine and depends on kitty keyboard protocol and kitty graphics virtual