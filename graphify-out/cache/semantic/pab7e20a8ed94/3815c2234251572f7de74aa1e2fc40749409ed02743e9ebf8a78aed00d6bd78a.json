{"nodes": [{"id": "claude_claude_md", "label": "CLAUDE.md (project instructions)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_symlink_dotfiles_architecture", "label": "Symlink-based dotfiles architecture", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "config/ is the source of truth; scripts/link.sh creates symlinks into place."}, {"id": "claude_omarchy_linux_target", "label": "omarchy (Arch Linux) target", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makefile and scripts branch on uname -s; omarchy owns packages, login shell and several configs, so each path is replaced by the repo's file or left alone per app; ~/.ssh/config is kept as config.omarchy.bak."}, {"id": "claude_linux_package_list", "label": "config/packages/linux.txt", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Linux counterpart of the Brewfile; fed to omarchy pkg add by scripts/pkg.sh; AUR not used, HackGen fetched upstream."}, {"id": "claude_scripts_pkg_sh", "label": "scripts/pkg.sh", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_scripts_link_sh", "label": "scripts/link.sh", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_scripts_runtime_sh", "label": "scripts/runtime.sh", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds runtimes with mise use -g instead of linking a mise config; mise owns ~/.config/mise/config.toml on both OSes."}, {"id": "claude_mise", "label": "mise", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_idempotent_scripts", "label": "Idempotent scripts (set -euo pipefail)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scripts check for existing files before linking so re-runs never overwrite existing configuration."}, {"id": "claude_copied_not_symlinked_configs", "label": "Copied (not symlinked) configs", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".gitconfig, .gitconfig-work, SSH config and ~/.zshrc.work are copied to allow local modification."}, {"id": "claude_herdr", "label": "herdr (terminal multiplexer)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns panes, tabs, workspaces and copy mode; holds the prefix ctrl+g so the terminal must not bind pane/tab keys that would shadow it."}, {"id": "claude_herdr_config_toml", "label": "config/herdr/config.toml", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-written entries limited to deviations from herdr --default-config so upgrades do not become full-file diffs; herdr also writes machine keys via its UI."}, {"id": "claude_ghostty", "label": "Ghostty", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terminal herdr runs on; herdr vendors Ghostty's VT engine and depends on the kitty keyboard protocol and kitty graphics virtual placeholders, both implemented by Ghostty."}, {"id": "claude_ghostty_config", "label": "config/ghostty/config.ghostty", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_hammerspoon", "label": "Hammerspoon Option+Space hotkey", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_kitty_protocols", "label": "kitty keyboard and graphics protocols", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_brewfile", "label": "Brewfile", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ruby evaluated by brew bundle so entries can be gated with if personal; keeps one tracked alphabetical list serving machines with and without self-managed applications; run without --cleanup so gated-off entries are skipped not uninstalled."}, {"id": "claude_personal_marker", "label": "~/.config/dotfiles/personal marker", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marker presence is the only discriminator by design; hardcoded under $HOME because brew bundle scrubs XDG_CONFIG_HOME; make personal is kept out of make all so a machine never opts itself in."}, {"id": "claude_makefile", "label": "Makefile", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_scripts_llm_sh", "label": "scripts/llm.sh", "file_type": "code", "source_file": "CLAUDE.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates herdr skill, installs herdr integration and hooks, installs plugins from llm/plugins.tsv, links skills, and prints compare URLs for vendored skills without applying them."}, {"id": "claude_pstack_delegation", "label": "Delegation through pstack", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delegation goes through pstack; herdr is used only when asked for."}, {"id": "claude_fail_open_hooks", "label": "Fail-open hooks (llm/hooks/)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each SessionStart/PreToolUse hook does nothing when it cannot decide rather than erroring."}], "edges": [{"source": "claude_claude_md", "target": "claude_symlink_dotfiles_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L5", "weight": 1.0}, {"source": "claude_scripts_link_sh", "target": "claude_symlink_dotfiles_architecture", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L5", "weight": 1.0}, {"source": "claude_claude_md", "target": "claude_makefile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L5", "weight": 1.0}, {"source": "claude_claude_md", "target": "claude_omarchy_linux_target", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", 